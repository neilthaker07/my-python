APP_NAME="Task Assistant"
# Tasks and users. Same Postgres database as the knowledge base below (docker-compose.yml)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/task_assistant

# Postgres + pgvector for the RAG knowledge base (matches docker-compose.yml)
KNOWLEDGE_DB_URL=postgresql+psycopg://postgres:postgres@localhost:5432/task_assistant
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Where the MCP server reaches the task REST API (the uvicorn server)
TASK_API_URL=http://127.0.0.1:8000

# LLM provider: any API compatible with the OpenAI Responses API.
# Groq (free tier): create a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
ROUTER_MODEL=openai/gpt-oss-20b
ANSWER_MODEL=openai/gpt-oss-120b
# Grades answers in the evals (python -m evals.run); best a different model family
JUDGE_MODEL=qwen/qwen3.8-27b

# User the standalone MCP server acts as for clients that send none (e.g. MCP Inspector)
# MCP_DEFAULT_USER_ID=1

# Roles allowed to create tasks via the assistant (the MCP create_task tool)
MCP_CREATE_TASK_ROLES=manager,admin

# Online evals: score live /assistant traffic in the background (admins: GET /evals/online/summary)
ONLINE_EVAL_ENABLED=true
ONLINE_EVAL_JUDGE_SAMPLE_RATE=0.2
ONLINE_EVAL_MIN_RETRIEVAL_SCORE=0.6
